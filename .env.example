# ═══════════════════════════════════════════════════════════
# Botlify (Hotels) — backend environment
# Copy to .env and fill in. Groups marked REQUIRED must be set
# for the app to run in production.
# ═══════════════════════════════════════════════════════════

# ─── App (REQUIRED) ────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Public URL of THIS backend (webhooks/callbacks are built from it)
API_PUBLIC_URL=https://your-backend.onrender.com
# Extra allowed CORS origins, comma-separated (localhost/vercel are built in)
CORS_ORIGINS=

# ─── Database (REQUIRED) ───────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/botlify
# Redis (BullMQ + rate limiting) — URL form preferred
REDIS_URL=
# ...or discrete parts:
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=

# ─── Auth (REQUIRED) ───────────────────────────────────────
JWT_SECRET=change_me_64_random_chars
JWT_REFRESH_SECRET=change_me_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# AES key for encrypting provider account ids/tokens at rest
AES_SECRET_KEY=change_me_32_bytes
GOOGLE_CLIENT_ID=
TURNSTILE_SECRET_KEY=

# ─── Admin panel (REQUIRED) ────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOTIFY_EMAIL=

# ─── AI — Gemini (REQUIRED) ────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-flash-lite-latest
# Groq (hashtag research only — optional)
GROQ_API_KEY=

# ─── Social channels — Zernio hosted provider (REQUIRED) ───
# One Zernio account powers Instagram + WhatsApp + TikTok.
BOTLIFY_IG_PROVIDER_BASE_URL=https://zernio.com/api/v1
BOTLIFY_IG_PROVIDER_API_KEY=
BOTLIFY_IG_PROVIDER_PROFILE_ID=
BOTLIFY_IG_PROVIDER_WEBHOOK_SECRET=

# ─── OTA sync — Channex (REQUIRED for Booking.com/Airbnb) ──
# Staging: https://staging.channex.io/api/v1 (free sandbox)
# Production: https://app.channex.io/api/v1
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
# Self-chosen random secret; embedded in our webhook callback URL
CHANNEX_WEBHOOK_TOKEN=

# ─── Airport transfers — Mozio (optional) ──────────────────
# Testing: https://api-testing.mozio.com/v2 ; production: https://api.mozio.com/v2
MOZIO_BASE_URL=https://api-testing.mozio.com/v2
MOZIO_API_KEY=
# Our partner margin on Mozio transfers (ledger bookkeeping)
MOZIO_MARGIN_RATE=0.08

# ─── Billing — Creem (REQUIRED, active provider) ───────────
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# "test" or "production"
CREEM_ENV=production
# Product ids for the $49 hotel plan (create in Creem dashboard,
# 3-day trial configured on the product)
CREEM_PRODUCT_HOTEL_PRO_MONTHLY=
CREEM_PRODUCT_HOTEL_PRO_ANNUAL=
# Legacy IG-era products (only needed while old subscribers exist)
CREEM_PRODUCT_IG_STARTER_MONTHLY=
CREEM_PRODUCT_IG_STARTER_ANNUAL=
CREEM_PRODUCT_IG_PRO_MONTHLY=
CREEM_PRODUCT_IG_PRO_ANNUAL=

# ─── Email — Brevo (REQUIRED) ──────────────────────────────
BREVO_API_KEY=
FROM_EMAIL=hello@botlify.site
SUPPORT_EMAIL=support@botlify.site

# ─── Media — Cloudinary (REQUIRED for photo uploads) ───────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Optional services ─────────────────────────────────────
SCRAPINGBEE_API_KEY=
SENTRY_DSN=
MESSAGE_TTL_DAYS=180
# Direct Meta OAuth fallback for Instagram (rarely used; Zernio is primary)
IG_APP_ID=
IG_APP_SECRET=
IG_OAUTH_REDIRECT_URI=
IG_WEBHOOK_VERIFY_TOKEN=

# ─── Rate limiting (defaults are fine) ─────────────────────
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
REGISTER_RATE_LIMIT_MAX=
